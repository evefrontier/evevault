{
  "name": "eve-frontier-vault",
  "private": true,
  "version": "0.0.11",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "turbo run dev",
    "dev:ext": "turbo run dev --filter=@evevault/extension",
    "dev:ext:direct": "bun --cwd apps/extension run dev",
    "dev:web": "turbo run dev --filter=@evevault/web",
    "build": "turbo run build",
    "build:ext": "turbo run build --filter=@evevault/extension",
    "build:ext:webstore": "bun --cwd apps/extension run build:webstore",
    "build:web": "turbo run build --filter=@evevault/web",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "clean:cache": "node scripts/clean-cache.js",
    "clean:all": "./scripts/clean-all.sh",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "test:run": "turbo run test:run",
    "zip:ext:webstore": "bun --cwd apps/extension run zip:webstore",
    "test:coverage": "turbo run test:coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@evefrontier/wallet-core": "0.0.6",
    "@mysten/sui": "^2.23.1",
    "@mysten/wallet-standard": "^0.20.3",
    "jose": "6.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "tmp": "^0.2.6",
    "shell-quote": "^1.8.5",
    "axios": "^1.16.0",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "valibot": "^1.4.2",
    "postcss": "^8.5.18",
    "protobufjs": "^7.6.5",
    "vite": "^7.3.3",
    "adm-zip": "^0.6.0",
    "brace-expansion": "^5.0.8",
    "fast-uri": "^3.1.4",
    "@mysten/sui": "^2.22.1"
  }
}
