#!/usr/bin/env sh
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm use 25 --silent
export TURBO_UI=false
export PATH="$HOME/.bun/bin:$PATH"
# GHSA-3v7f-55p6-f55p / GHSA-c2c7-rcm5-vvqj: picomatch 2.3.1 nested inside micromatch/anymatch/readdirp.
# A global override to 2.3.2 would break fdir (requires picomatch ^3||^4). Dev-only, no runtime exposure.
# GHSA-vpq2-c234-7xj6: @tootallnate/once 2.x in teeny-request > http-proxy-agent@5. Upgrading to 3.x
# is a breaking change for that package. Dev-only, no runtime exposure.
# GHSA-gcqx-w48m-w2h4: deepmerge <= 4.3.1, no patched release. Its CVE was rejected on 2026-11-02
# as not a vulnerability (https://www.cve.org/CVERecord?id=CVE-2026-93753) but the advisory is
# not withdrawn. Dev-only (vite-plugin-pwa > workbox-build), no runtime exposure.
bun audit --ignore=GHSA-gcqx-w48m-w2h4
NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage" bun run test:run
