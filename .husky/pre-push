#!/usr/bin/env sh
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm use --silent
export TURBO_UI=false
export PATH="$HOME/.bun/bin:$PATH"
# GHSA-3v7f-55p6-f55p / GHSA-c2c7-rcm5-vvqj: picomatch 2.3.1 nested inside micromatch/anymatch/readdirp.
# A global override to 2.3.2 would break fdir (requires picomatch ^3||^4). Dev-only, no runtime exposure.
# GHSA-vpq2-c234-7xj6: @tootallnate/once 2.x in teeny-request > http-proxy-agent@5. Upgrading to 3.x
# is a breaking change for that package. Dev-only, no runtime exposure.
# GHSA-fc5q-39xc-vjpf: high ReDoS in picomatch <=4.0.7, no patched release yet
# (4.0.7 is latest on npm). picomatch only arrives through build/test/lint tooling
# (vite, vitest, tinyglobby/fdir, ...), never in shipped code. Remove this ignore
# once a fixed picomatch is out, past minimumReleaseAge and in the lockfile, i.e.
# when a plain `bun audit` passes.
bun audit --ignore=GHSA-fc5q-39xc-vjpf
NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage" bun run test:run
