{
  "name": "@evevault/shared",
  "version": "0.0.18",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./wallet": {
      "development": "./src/wallet/index.ts",
      "default": "./dist/wallet/index.js"
    },
    "./wallet/aliasCall": {
      "development": "./src/wallet/aliasCall.ts",
      "default": "./dist/wallet/aliasCall.js"
    },
    "./sui": {
      "development": "./src/sui/index.ts",
      "default": "./dist/sui/index.js"
    },
    "./auth": {
      "development": "./src/auth/index.ts",
      "default": "./dist/auth/index.js"
    },
    "./types": {
      "development": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "development": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./logger": {
      "development": "./src/utils/logger.ts",
      "default": "./dist/utils/logger.js"
    },
    "./design": {
      "development": "./src/design/index.ts",
      "default": "./dist/design/index.js"
    },
    "./theme": {
      "development": "./src/theme/index.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/global.css": "./src/theme/global.css",
    "./components": {
      "development": "./src/components/index.ts",
      "default": "./dist/components/index.js"
    },
    "./screens": {
      "development": "./src/screens/index.ts",
      "default": "./dist/screens/index.js"
    },
    "./queryClient": {
      "development": "./src/queryClient.ts",
      "default": "./dist/queryClient.js"
    },
    "./router": {
      "development": "./src/router/index.ts",
      "default": "./dist/router/index.js"
    },
    "./adapters": {
      "development": "./src/adapters/index.ts",
      "default": "./dist/adapters/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "default": "./dist/testing/index.js"
    },
    "./stores": {
      "development": "./src/stores/index.ts",
      "default": "./dist/stores/index.js"
    },
    "./stores/*": {
      "development": "./src/stores/*.ts",
      "default": "./dist/stores/*.js"
    },
    "./hooks": {
      "development": "./src/hooks/index.ts",
      "default": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run copy-assets",
    "copy-assets": "rsync -avm --include='*/' --include='*.css' --exclude='*' src/ dist/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --config ./vitest.config.mts",
    "test:ui": "vitest --ui --config ./vitest.config.mts",
    "test:run": "vitest run --config ./vitest.config.mts",
    "test:coverage": "vitest run --config ./vitest.config.mts --coverage"
  },
  "dependencies": {
    "@mysten/signers": "^1.0.5",
    "@wxt-dev/browser": "0.2.5",
    "hash-wasm": "4.12.0"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.17.0",
    "@mysten/wallet-standard": "^0.20.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@types/react": "^19.2.17",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "jose": "6.0.12"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@vitest/browser-playwright": "4.1.10",
    "typescript": "^5.9.3"
  }
}
