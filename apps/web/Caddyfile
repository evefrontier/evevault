{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Same headers as amplify.yml customHeaders; keep the CSP in sync with
	# apps/extension/wxt.config.ts. Report-Only until the reports are clean.
	header {
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.sui.io https://*.evefrontier.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	# Hashed build assets: a missing one is a 404, never the SPA fallback, and
	# is not cached, since mid-rollout an old pod can miss a new asset.
	handle /assets/* {
		@exists file
		@missing not file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		file_server
	}

	# Everything else, including sw.js and the web manifest, is revalidated.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
